FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    git build-essential cmake curl \
    && rm -rf /var/lib/apt/lists/*

# Build vLLM from source for CPU backend
# Follow the official CPU build path from vLLM docs.
# Install the vLLM source tree here and build it in CPU mode.

EXPOSE 8000